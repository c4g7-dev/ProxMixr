# Server Configuration
PORT=3000

# Termix Configuration
TERMIX_URL=https://your-termix-instance.com
TERMIX_API_KEY=your-jwt-bearer-token-here

# Proxmox Configuration
PROXMOX_URL=https://your-proxmox-server.com:8006
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=your-proxmox-password
# OR use API token instead
PROXMOX_TOKEN_ID=user@realm!tokenid
PROXMOX_TOKEN_SECRET=your-token-secret

# SSH Configuration
DEFAULT_SSH_PORT=22
DEFAULT_SSH_USER=root
SSH_TIMEOUT_MS=3000

# Sync Configuration
AUTO_SYNC_ENABLED=false
AUTO_SYNC_INTERVAL_MINUTES=30
